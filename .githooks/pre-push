#!/usr/bin/env bash
# Garante que o snapshot do webapp (webapp/public/data) reflete o SQLite local antes de TODO
# push (qualquer branch) — a Vercel (Git integration, Root Directory webapp/) publica o que
# estiver commitado na main, mas manter os dados em dia em todo push evita surpresas.
# Instalado por `npm install` (postinstall → git config core.hooksPath .githooks).
#
# Duas políticas DIFERENTES convivem aqui de propósito:
#   • quanto ao PUSH, fail-open: o hook nunca pode travar trabalho legítimo (export falhou, node
#     ausente, banco em outra máquina → avisa e o push segue);
#   • quanto ao SNAPSHOT, fail-CLOSED: na dúvida NÃO commita. O dado publicado é a base de registro
#     do acervo (o histórico do git) e não tem cópia — perder por acidente é irreversível.
# A única exceção ao fail-open do push está no fim deste comentário.
#
# Ramos:
#   • deleção de ref → não faz nada;
#   • o export NÃO RODOU (máquina sem node/dependências) → avisa, restaura a árvore, NÃO commita e
#     segue para o guard (a checagem HEAD×ar abaixo não depende do export e continua valendo);
#   • o guard anti-encolhimento bloqueou o EXPORT (base local vazia/incompleta: o guard vive DENTRO
#     do exportWebSnapshot) → diz que foi o GUARD, não o ambiente, e o push segue SEM commit;
#   • guard anti-encolhimento bloqueou o COMMIT do snapshot → restaura a árvore e o push segue SEM commit;
#   • só a linha volátil `generatedAt` do meta.json mudou → restaura e o push segue;
#   • dado novo de verdade → commita webapp/public/data + webapp/public/api/v1 e ABORTA o push
#     (um commit criado durante o push não entra nele): repita o `git push`.
#
# A DECISÃO do guard NÃO mora aqui: ela é a mesma função JS que o `ncrawl deploy` usa
# (`src/snapshot-guard.js`, `evaluateSnapshotChange`), chamada por um `node -e` curto. A versão
# anterior era bash e tinha dois furos que este arquivo existe para fechar:
#   (a) `if [ -n "$total_novo" ] && [ -n "$total_head" ]` — falha de LEITURA DESLIGAVA o guard, e é
#       justamente quando não se sabe o total que não se pode publicar. Agora total ilegível
#       BLOQUEIA;
#   (b) comparava só com `HEAD:meta.json` — um RATCHET: assim que um snapshot encolhido entrasse no
#       HEAD, tudo que fosse >= a ele passaria para sempre. Agora o total NO AR entra na conta
#       (best-effort, com timeout), e a base é o MAIOR total conhecido.
# Opt-in explícito (hook não recebe flags): NC_ALLOW_SHRINK=1 libera encolher, NC_ALLOW_SHRINK=wipe
# libera zerar. Na CLI é `--allow-shrink` / `--allow-shrink wipe` — e o hook REPASSA o opt-in ao
# export, que tem o MESMO guard dentro (senão o export bloquearia antes e o opt-in não teria efeito).
#
# ÚNICA exceção ao fail-open do push: se o snapshot que JÁ ESTÁ COMMITADO no HEAD apagaria o acervo
# no ar e não há nada melhor p/ commitar, o push do ramo de publicação é ABORTADO — deixá-lo seguir
# seria publicar a destruição, que é exatamente o incidente 7c24491.
#
# O mesmo `export --format web` regenera a API pública em webapp/public/api/v1/corpus.json — ela
# viaja junto do snapshot em todos os ramos abaixo, pelos MESMOS guards.
set -u

DATA_DIR="webapp/public/data"
API_DIR="webapp/public/api/v1"
META="$DATA_DIR/meta.json"
CORPUS="$API_DIR/corpus.json"
ZERO="0000000000000000000000000000000000000000"
DEPLOY_BRANCH="${NC_DEPLOY_BRANCH:-main}"

# stdin do pre-push: "<local ref> <local sha> <remote ref> <remote sha>" por ref pushado.
# Só pula deleção de ref (local_sha zerado). `push_deploy` marca o push que a Vercel publica.
any_push=0
push_deploy=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$local_sha" != "$ZERO" ]; then
    any_push=1
    case "$remote_ref" in "refs/heads/$DEPLOY_BRANCH") push_deploy=1 ;; esac
  fi
done
[ "$any_push" = "1" ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 0

# Desfaz na árvore TUDO o que o export escreveu (os diretórios inteiros: o export reescreve também
# articles.json e os contents.partN.json) e remove os ÓRFÃOS que ele criou — restore/checkout não
# apagam arquivo não-rastreado, e sem isso uma parte nova ficaria pronta p/ o próximo `git add`.
#
# A remoção é por NOME (só o que o export gera: meta/articles/contents[.partN]/corpus), NUNCA pelo
# diretório: um `git clean -fd` nas duas pastas levaria junto qualquer arquivo do usuário guardado
# ali — com `-d`, diretórios inteiros — em silêncio e sem volta. O que sumir, sai em log.
restaura_snapshot() {
  git restore -- "$DATA_DIR" "$API_DIR" 2>/dev/null ||
    git checkout -- "$DATA_DIR" "$API_DIR" 2>/dev/null || true
  # --exclude-standard respeita o .gitignore do usuário; --others só lista não-rastreados.
  local orfaos
  orfaos=$(git ls-files --others --exclude-standard -- "$DATA_DIR" "$API_DIR" 2>/dev/null |
    grep -E "^($DATA_DIR/(meta|articles|contents)\.json|$DATA_DIR/contents\.part[0-9]+\.json|$API_DIR/corpus\.json)$" || true)
  [ -n "$orfaos" ] || return 0
  printf '%s\n' "$orfaos" | while IFS= read -r f; do
    [ -n "$f" ] && echo "[pre-push] removendo arquivo novo do export: $f" >&2
  done
  printf '%s\n' "$orfaos" | tr '\n' '\0' | xargs -0 -r git clean -f -- 2>/dev/null || true
}

# ---- o export (e a distinção entre "o guard bloqueou" e "o export não rodou aqui") ----
# O opt-in do AMBIENTE vira flag da CLI: o guard mora DENTRO do exportWebSnapshot (src/export-web.js,
# `assertSnapshotAllowed`), então sem repassar `--allow-shrink` o export bloquearia antes de escrever
# e o `NC_ALLOW_SHRINK` documentado aqui nunca teria efeito sobre o COMMIT do snapshot. A forma é com
# ESPAÇO (`--allow-shrink wipe`): o parseFlags de src/index.js NÃO quebra em `=`.
export_flags=()
case "${NC_ALLOW_SHRINK:-}" in
  '') ;;
  wipe) export_flags=(--allow-shrink wipe) ;;
  *) export_flags=(--allow-shrink) ;;
esac

# A saída do export é ESPELHADA (tee) e guardada: é ela que distingue os dois motivos de falha.
# Sem isso o hook culpava o ambiente ("sem banco/node aqui?") quando quem tinha barrado era o guard
# anti-encolhimento — e o usuário ia procurar o problema no lugar errado. O marcador é o NOME da
# exceção (`SnapshotShrinkError`, src/export-web.js), que o catch de topo do src/index.js imprime
# com stack em stderr junto da mensagem e da hint do guard.
echo "[pre-push] re-exportando o snapshot do webapp a partir do banco local…"
export_log=$(mktemp "${TMPDIR:-/tmp}/nc-pre-push-export.XXXXXX" 2>/dev/null || echo "")
if [ -n "$export_log" ]; then
  node --env-file-if-exists=.env src/index.js export --format web ${export_flags[@]+"${export_flags[@]}"} 2>&1 | tee "$export_log"
  export_rc=${PIPESTATUS[0]}
else
  node --env-file-if-exists=.env src/index.js export --format web ${export_flags[@]+"${export_flags[@]}"}
  export_rc=$?
fi

export_ok=1
if [ "$export_rc" != "0" ]; then
  export_ok=0
  if [ -n "$export_log" ] && grep -q 'SnapshotShrinkError' "$export_log"; then
    echo "" >&2
    echo "[pre-push] o GUARD ANTI-ENCOLHIMENTO bloqueou o export (mensagem e hint do guard logo acima): o snapshot recém-gerado encolheria/apagaria o acervo já publicado." >&2
    echo "[pre-push] NÃO é falha de ambiente — o export rodou; o banco local é que está vazio/incompleto (banco em outra máquina, NC_HOME diferente, reset/purge recente)." >&2
    echo "[pre-push] recupere o acervo com 'ncrawl restore' e repita o push; se a redução é MESMO deliberada: NC_ALLOW_SHRINK=1 git push (encolher) / NC_ALLOW_SHRINK=wipe git push (zerar)." >&2
  else
    echo "[pre-push] aviso: o export NÃO RODOU aqui (sem node/banco/dependências nesta máquina?) — push segue com o snapshot commitado." >&2
  fi
  # Fail-CLOSED quanto ao SNAPSHOT: nada é commitado, e o que o export tenha deixado pela metade na
  # árvore volta ao estado do HEAD (o guard bloqueia antes do 1º byte, mas uma falha DEPOIS dele —
  # ex.: a API pública — deixaria arquivo modificado pronto p/ um `git add` distraído).
  restaura_snapshot
  # NÃO sai aqui: o export falhar não pode desligar a ÚNICA exceção ao fail-open (abortar o push
  # quando o snapshot JÁ COMMITADO apagaria o acervo no ar). Essa checagem não depende do export —
  # ela compara o HEAD com o site — e é justamente depois de um `reset` (que commita a remoção do
  # snapshot) que o export falha e o push publicaria a destruição. O guard abaixo roda sobre a
  # árvore restaurada = o snapshot do HEAD, então nada novo é commitado (real_change fica 0).
fi
rm -f "$export_log"

# ---- guard anti-encolhimento: a MESMA decisão do `ncrawl deploy` (src/snapshot-guard.js) ----
# Saída (stdout, 5 campos): "<novo> <head> <no-ar> <acao-snapshot> <acao-push>", com "?" p/ total
# desconhecido. As mensagens humanas saem em stderr. O script sai 0 mesmo bloqueando: quem decide o
# destino do PUSH é o bash abaixo, a partir das duas ações.
GUARD_JS=$(cat <<'GUARD_EOF'
import { readFileSync, writeSync } from "node:fs";
import { execFileSync } from "node:child_process";
import {
  evaluateSnapshotChange, articlesFromMeta, SHRINK_OPT_IN, WIPE_OPT_IN,
} from "./src/snapshot-guard.js";

const META = "webapp/public/data/meta.json";
const optIn = process.env.NC_ALLOW_SHRINK;

// Total do snapshot recém-exportado (o que seria commitado).
let novo = null;
try { novo = articlesFromMeta(readFileSync(META, "utf8")); } catch {}

// Total já commitado no HEAD (o que o push publicaria se nada for commitado agora).
let head = null;
try {
  head = articlesFromMeta(execFileSync("git", ["show", `HEAD:${META}`], {
    encoding: "utf8", maxBuffer: 64 * 1024 * 1024, stdio: ["ignore", "pipe", "ignore"],
  }));
} catch {}

// Total NO AR: é ele que quebra o ratchet de comparar só com o HEAD. Best-effort, com timeout —
// um hook não pode ficar pendurado na rede. NC_HOOK_LIVE_MS=0 desliga a consulta.
// O default do site é repetido aqui (em vez de importar src/config.js) de propósito: config.js
// cria NC_HOME e carrega .env no import, e um hook não deve ter esse efeito colateral. Quem muda
// o alvo passa NC_SITE_URL/NC_SITE_META_PATH no AMBIENTE do push (não pelo NC_HOME/.env).
let live = null;
const liveMs = Number(process.env.NC_HOOK_LIVE_MS ?? 4000);
if (liveMs > 0) {
  const base = (process.env.NC_SITE_URL || "https://newsletter-crawler.vercel.app").replace(/\/+$/, "");
  const metaPath = process.env.NC_SITE_META_PATH || "/data/meta.json";
  try {
    const res = await fetch(`${base}${metaPath}?t=${Date.now()}`, {
      signal: AbortSignal.timeout(liveMs), headers: { "cache-control": "no-cache" },
    });
    if (res.ok) live = articlesFromMeta(await res.text());
  } catch {}
}

const snapshot = evaluateSnapshotChange({ novo, head, live, allowShrink: optIn });
// O que o PUSH publica é o snapshot do HEAD, não o da árvore de trabalho.
const push = evaluateSnapshotChange({ novo: head, head: null, live, allowShrink: optIn });

// Escrita SÍNCRONA (fd 1/2): `process.stdout.write` p/ um pipe — e o hook captura a saída com
// `$( )` — pode ser assíncrono, e o process.exit() logo abaixo truncaria o texto. EAGAIN = pipe
// cheio, tenta de novo.
const escreve = (fd, texto) => {
  const buf = Buffer.from(texto);
  let off = 0;
  while (off < buf.length) {
    try { off += writeSync(fd, buf, off); } catch (e) { if (e.code !== "EAGAIN") return; }
  }
};
const n = (x) => (x == null ? "?" : String(x));
const acaoPush = live == null ? "allow" : push.action; // sem o total do ar não há o que provar
const say = (m) => escreve(2, `[pre-push] ${m}\n`);
if (snapshot.action === "block") {
  say(snapshot.message);
  if (snapshot.hint) say(snapshot.hint);
  say(`opt-in por ambiente: NC_ALLOW_SHRINK=1 (encolher) / NC_ALLOW_SHRINK=wipe (zerar) — na CLI, "${SHRINK_OPT_IN}" / "${WIPE_OPT_IN}".`);
} else if (snapshot.override) {
  say(`ATENCAO override (NC_ALLOW_SHRINK): ${snapshot.message}`);
  say("ATENCAO o historico do git e a base de registro do acervo: isto nao se desfaz pelo site.");
}
escreve(1, [n(novo), n(head), n(live), snapshot.action, acaoPush].join(" ") + "\n");

// SAI AGORA que o veredito está escrito. Sem isto o processo ainda ficava ~6,5s pendurado quando o
// site não responde ao SYN (firewall/VPN, situação comum): o AbortSignal.timeout rejeita a promessa
// em 4s mas NÃO fecha o socket de connect pendente do undici, cujo connectTimeout é 10s — e o hook
// espera este processo (`guard_out=$(node …)`), então o custo era pago em TODO push. Medido: 10,6s
// → ~4,1s. A consulta ao ar NÃO é pulada em branch de trabalho de propósito: é ela que evita o
// ratchet (um snapshot encolhido no HEAD virar licença) também fora do ramo de publicação.
process.exit(0);
GUARD_EOF
)

if ! guard_out=$(node --input-type=module -e "$GUARD_JS"); then
  guard_out=""
  echo "[pre-push] aviso: o guard anti-encolhimento não rodou — o snapshot NÃO será commitado." >&2
fi
# Saída malformada/ausente = desconhecido: bloqueia o COMMIT do snapshot (fail-safe p/ o dado) e
# deixa o push seguir (fail-open p/ o trabalho).
[ "$(printf '%s\n' "$guard_out" | wc -w | tr -d ' ')" = "5" ] || guard_out="? ? ? block allow"
# `set -f` é obrigatório: o campo "?" (total desconhecido) é um GLOB — sem isso o shell o trocaria
# por um arquivo de nome de 1 caractere do repo e o guard leria lixo.
set -f
set -- $guard_out
set +f
total_novo="$1"; total_head="$2"; total_live="$3"; acao_snapshot="$4"; acao_push="$5"
[ "$total_novo" = "?" ] && total_novo=""
[ "$total_head" = "?" ] && total_head=""
[ "$total_live" = "?" ] && total_live=""

# Única saída != 0 que não é "commitei, repita o push": o snapshot COMMITADO apagaria o acervo no
# ar e não temos nada melhor p/ commitar — deixar o push seguir publicaria a destruição.
aborta_se_head_apaga_o_ar() {
  [ "$acao_push" = "block" ] || return 0
  [ "$push_deploy" = "1" ] || return 0
  echo "" >&2
  echo "[pre-push] PUSH ABORTADO: o snapshot COMMITADO no HEAD (${total_head:-?} artigos) destruiria o acervo publicado (${total_live:-?} no ar)." >&2
  echo "[pre-push] corrija o commit antes de publicar: re-exporte com o banco COMPLETO e commite por cima, ou 'git revert' o commit que encolheu o snapshot." >&2
  echo "[pre-push] se a redução é MESMO deliberada: NC_ALLOW_SHRINK=wipe git push" >&2
  exit 1
}

if [ "$acao_snapshot" = "block" ]; then
  restaura_snapshot
  echo "[pre-push] nada foi commitado; o push segue com o snapshot que já está no repositório." >&2
  aborta_se_head_apaga_o_ar
  exit 0
fi

# Mudança real = qualquer coisa no dir de dados além do bump do generatedAt de meta/corpus.
# `git diff` não enxerga arquivo NOVO não-rastreado, e o export partiçãou o contents.json único
# (que passou de 100 MB, rejeitado pelo GitHub) em contents.partN.json: a 1ª rodada pós-partição
# CRIA as partes do zero e REMOVE o arquivo antigo — tudo isso é mudança real. O status porcelain
# do dir inteiro decide: uma entrada que não seja só meta.json/corpus.json modificados = dado
# novo; o que sobra em meta/corpus (o bump do generatedAt) é comparado ignorando essa linha.
real_change=0
# Export que não rodou não gera dado novo p/ commitar — a árvore já voltou ao HEAD acima.
statuses=$([ "$export_ok" = "1" ] && git status --porcelain -- "$DATA_DIR" "$API_DIR" || true)
resto=$(printf '%s\n' "$statuses" | grep -vF "$META" | grep -vF "$CORPUS" || true)
if [ "$export_ok" != "1" ]; then
  real_change=0
elif [ -n "$resto" ]; then
  real_change=1
elif ! diff -q <(git show "HEAD:$META" 2>/dev/null | grep -v '"generatedAt"') \
  <(grep -v '"generatedAt"' "$META") >/dev/null 2>&1; then
  real_change=1
elif ! diff -q <(git show "HEAD:$CORPUS" 2>/dev/null | grep -v '"generatedAt"') \
  <(grep -v '"generatedAt"' "$CORPUS") >/dev/null 2>&1; then
  real_change=1
fi

if [ "$real_change" = "0" ]; then
  restaura_snapshot
  aborta_se_head_apaga_o_ar
  if [ "$export_ok" = "1" ]; then
    echo "[pre-push] snapshot já em dia (${total_head:-?} artigos) — push segue."
  else
    echo "[pre-push] nada a commitar (o export não rodou) — push segue com o snapshot do repositório (${total_head:-?} artigos)."
  fi
  exit 0
fi

git add -- "$DATA_DIR" "$API_DIR"
if ! git commit --no-verify -m "chore(data): atualiza snapshot do webapp + API pública (pre-push, ${total_novo:-?} artigos)" -- "$DATA_DIR" "$API_DIR"; then
  echo "[pre-push] aviso: commit do snapshot falhou — push segue sem ele." >&2
  exit 0
fi
echo ""
echo "[pre-push] o banco local tinha dado novo: snapshot exportado e commitado (${total_head:-?} → ${total_novo:-?} artigos)."
echo "[pre-push] este push foi INTERROMPIDO de propósito — um commit criado durante o push não entra nele."
echo "[pre-push] rode 'git push' de novo para publicar tudo (a Vercel faz o deploy sozinha)."
exit 1
